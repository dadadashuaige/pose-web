# 复制为 backend/.env 后按需修改。
#
# 优先级：系统环境变量 > backend/.env > 代码默认值
# 说明：.env 是按「当前工作目录」查找的，所以请从项目根目录运行 run.ps1，
#       或先手动 cd 到 backend/ 再启动 uvicorn。

# ---------------------------------------------------------------- 运行
DEVICE=cuda
DATABASE_URL=sqlite:///./data/elevator_risk.db

# ---------------------------------------------------------------- 引擎默认值
# 页面上的下拉框会覆盖这里的默认选择

# 姿态模型：yolo11n（通用，零配置可用）| mec（自训练，需自行提供权重）
POSE_ENGINE=yolo11n

# 行为识别：none（只出关键点）| rule（电梯六种行为的规则引擎）
#          | llm（大模型判定）| stgcn（PCG-GCN，需自行提供权重）
BEHAVIOR_ENGINE=none

# 建议来源：template（手写模板）| llm（大模型）| rag（大模型 + 知识库）
ADVICE_ENGINE=template

# ---------------------------------------------------------------- 门区域
# 归一化坐标 (x1,y1,x2,y2)，取值 0~1。电梯机位固定，标定一次即可。
#
# 「踢门 / 推门 / 扒门 / 靠门」四类行为都依赖这块区域：
#   * 留空  -> 这四类不参与判定，结果里会写明原因（推荐先留空，跑一次再标定）
#   * 填值  -> 用页面上的拖拽会更准，也可以在这里手填
# 注意：阈值边界要贴着真实的门，区域给大了会把"站在轿厢中间"也算成"贴近门"。
DOOR_ROI=

# ---------------------------------------------------------------- 通用姿态度量
# 每 N 帧取 1 帧做推理；帧数上限用于控制单次任务耗时
FRAME_STRIDE=3
MAX_SAMPLE_FRAMES=600
POSE_CONFIDENCE=0.35
MAX_PEOPLE=8

# 可视化视频：输出 WebM(VP8)，浏览器可直接播放；回退顺序 VP8 -> VP9 -> mp4v
OVERLAY_ENABLED=1
# 输出宽度上限。编码耗时大致与像素数成正比，这是最有效的那个旋钮：
# 实测同一段视频 1280 宽编码 15.5 秒，854 宽只要 7.7 秒。
OVERLAY_MAX_WIDTH=1280
# 输出帧率。0 = 跟随源视频帧率（最流畅）。
# 注意效果有限：重复帧编码很便宜，真正花钱的是每个采样帧本身。
# 实测 30fps 输出 420 帧 ≈ 20 秒，10fps 输出 140 帧 ≈ 15.5 秒，只省了 4.5 秒。
OVERLAY_FPS=0

# ---------------------------------------------------------------- 自训练 MEC-Pose（可选）
# 这是 YOLOv5-Pose 格式的权重，加载时必须同时提供训练仓库源码目录，
# 否则反序列化会报 No module named 'models'。
# 不使用自训练模型时留空即可，程序会跳过这个引擎。
# MEC_WEIGHTS=E:\path\to\runs\train\exp102\weights\best.pt
# MEC_REPO=E:\path\to\edgeai-yolov5-yolo-pose

# 通用权重路径：只写文件名时会自动下载到当前工作目录
# YOLO11N_WEIGHTS=yolo11n-pose.pt

# ---------------------------------------------------------------- PCG-GCN（保留，默认不启用）
# 当前公开权重是 NTU RGB+D 60 类通用模型，没有用电梯数据训练，
# 实测会把画面判成 cheer up / hopping 之类，无法对应电梯危险行为。
# 用电梯数据微调后再把 BEHAVIOR_ENGINE 改成 stgcn 即可启用。
# STGCN_WEIGHTS=E:\path\to\epoch80_model.pt
# STGCN_REPO=E:\path\to\st-gcn

# ---------------------------------------------------------------- 大模型
# 留空则行为引擎与建议引擎都会自动走本地规则，全流程仍然可用。
#
# 重要：LLM_MODEL 必须填 LLM_BASE_URL 那个端点实际提供的模型名，
#       两者不匹配时不会报错，只会静默退回本地规则。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------- 知识库检索
# 留空则复用 LLM_API_KEY；都为空时自动退化为内置关键词检索（BM25），功能不中断
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-v3   # 阿里云百炼/Qwen 端点
KNOWLEDGE_DIR=
RAG_TOP_K=5

# ---------------------------------------------------------------- 数据生命周期
# 原始视频保留天数，超期自动清理（报告与关键帧保留）。0 = 不自动清理
RAW_VIDEO_RETAIN_DAYS=0
