# 未配置 LLM 时，系统会使用本地规则分析，便于先跑通全流程。
# 配了 Key 后请注意：OPENAI_MODEL 必须填 BASE_URL 那个端点实际提供的模型名，
# 两者不匹配时不会报错，只会静默退回本地规则（表现为"配了 Key 却没用 LLM"）。
# 下面这个默认值只适用于官方 OpenAI 端点；用阿里云百炼/Qwen 端点请改成 qwen3.7-plus。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# 首次运行会自动下载 yolo11n-pose.pt 权重。
YOLO_MODEL=yolo11n-pose.pt
YOLO_CONFIDENCE=0.35
MAX_UPLOAD_MB=10
